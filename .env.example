# Clerk authentication (app works without it — auth is disabled)
VITE_CLERK_PUBLISHABLE_KEY=

# ElevenLabs TTS (app falls back to browser speech synthesis without it).
# The key must have the `text_to_speech` permission. ElevenLabs keys are
# scoped per-permission and a newly created key can have none, in which case
# every call returns 401 "missing the permission text_to_speech" and the coach
# silently speaks in the robotic browser voice instead.
VITE_ELEVENLABS_API_KEY=
# Voice ID for the coach. Falls back to a stock voice if unset.
# Note: the client sends this to /api/tts, so when both this and the server-side
# ELEVENLABS_VOICE_ID are set, this one wins. Leave it unset to let the server decide.
VITE_ELEVENLABS_VOICE_ID=

# ElevenLabs Conversational AI agent for the speech-to-speech coach.
# Without it the "Talk to the coach" button is hidden.
VITE_ELEVENLABS_AGENT_ID=
# Only for private agents: endpoint returning { signedUrl } so the API key stays server-side.
VITE_ELEVENLABS_SIGNED_URL_ENDPOINT=

# --- Server-side (Vercel functions; NOT exposed to the browser) ---
# Set these in the Vercel dashboard, without the VITE_ prefix.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=
